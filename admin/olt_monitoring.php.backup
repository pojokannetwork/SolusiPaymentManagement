<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
const csrfToken = '<?php echo $csrfToken; ?>';
let deviceModal;

document.addEventListener('DOMContentLoaded', () => {
    deviceModal = new bootstrap.Modal(document.getElementById('deviceModal'));
    setupEventHandlers();
    loadSummary();
    loadDevices();
    loadOnts();
    loadEvents();
    loadSettings();
});

function setupEventHandlers() {
    document.getElementById('btn-refresh-sample').addEventListener('click', () => {
        generateSampleData();
    });

    document.getElementById('btn-open-create').addEventListener('click', () => {
        openDeviceModal();
    });

    document.getElementById('device-polling-method').addEventListener('change', toggleSnmpFields);
    document.getElementById('device-form').addEventListener('submit', submitDeviceForm);

    document.getElementById('filter-olt').addEventListener('change', loadOnts);
    document.getElementById('filter-status').addEventListener('change', loadOnts);
    document.getElementById('filter-search').addEventListener('input', debounce(loadOnts, 400));

    document.getElementById('btn-refresh-events').addEventListener('click', loadEvents);
    document.getElementById('btn-refresh-events-table').addEventListener('click', loadEventsTable);
    document.getElementById('filter-event-severity').addEventListener('change', loadEventsTable);
    document.getElementById('filter-event-olt').addEventListener('change', loadEventsTable);

    document.getElementById('settings-form').addEventListener('submit', submitSettingsForm);
    document.getElementById('thresholds-form').addEventListener('submit', submitThresholdsForm);
    document.getElementById('btn-reset-thresholds').addEventListener('click', resetThresholdDefaults);
}

function loadSummary() {
    fetch('/api/admin/olt_monitoring.php?action=summary', { headers: buildHeaders() })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) {
                throw new Error(response.message || 'Gagal memuat ringkasan');
            }
            const data = response.data || {};
            document.getElementById('summary-total-olts').textContent = data.olts?.total ?? 0;
            document.getElementById('summary-online-olts').textContent = data.olts?.online ?? 0;
            const totalWarnings = (data.warnings?.power ?? 0) + (data.warnings?.distance ?? 0);
            document.getElementById('summary-warnings').textContent = totalWarnings;
            document.getElementById('warning-power-count').textContent = data.warnings?.power ?? 0;
            document.getElementById('warning-distance-count').textContent = data.warnings?.distance ?? 0;

            document.getElementById('summary-total-onts').textContent = data.onts?.total ?? 0;

            renderRecentEvents(data.recent_events || []);
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function loadDevices() {
    fetch('/api/admin/olt_monitoring.php?action=devices', { headers: buildHeaders() })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal memuat perangkat');
            renderDevices(response.data?.devices || []);
            populateOltFilters(response.data?.devices || []);
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function loadOnts() {
    const params = new URLSearchParams({
        olt_id: document.getElementById('filter-olt').value,
        status: document.getElementById('filter-status').value,
        search: document.getElementById('filter-search').value
    });

    fetch('/api/admin/olt_monitoring.php?action=onts&' + params.toString(), { headers: buildHeaders() })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal memuat ONT');
            renderOnts(response.data?.onts || []);
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function loadEvents() {
    loadSummary();
    loadEventsTable();
}

function loadEventsTable() {
    const params = new URLSearchParams({
        severity: document.getElementById('filter-event-severity').value,
        olt_id: document.getElementById('filter-event-olt').value,
        limit: 100
    });

    fetch('/api/admin/olt_monitoring.php?action=events&' + params.toString(), { headers: buildHeaders() })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal memuat event');
            renderEventsTable(response.data?.events || []);
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function loadSettings() {
    fetch('/api/admin/olt_monitoring.php?action=settings', { headers: buildHeaders() })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal memuat pengaturan');
            applySettingsForm(response.data?.settings || {});
            return fetch('/api/admin/olt_monitoring.php?action=thresholds', { headers: buildHeaders() });
        })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal memuat threshold');
            renderThresholds(response.data?.thresholds || {});
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function submitDeviceForm(event) {
    event.preventDefault();

    const formData = new FormData(event.target);
    const payload = Object.fromEntries(formData.entries());
    const isEdit = payload.id && payload.id !== '';
    const action = isEdit ? 'update_device' : 'create_device';

    fetch('/api/admin/olt_monitoring.php?action=' + action, {
        method: 'POST',
        headers: buildHeaders(),
        body: JSON.stringify(payload)
    })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal menyimpan perangkat');
            deviceModal.hide();
            showAlert(response.message || 'Perangkat disimpan', 'success');
            loadDevices();
            loadOnts();
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function submitSettingsForm(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const settings = {};
    formData.forEach((value, key) => { settings[key] = value; });

    fetch('/api/admin/olt_monitoring.php?action=save_settings', {
        method: 'POST',
        headers: buildHeaders(),
        body: JSON.stringify({ settings })
    })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal menyimpan pengaturan');
            showAlert('Pengaturan berhasil disimpan', 'success');
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function submitThresholdsForm(event) {
    event.preventDefault();
    const thresholds = {};
    document.querySelectorAll('#thresholds-table-body tr').forEach(row => {
        const metric = row.dataset.metric;
        const level = row.dataset.level;
        thresholds[metric] = thresholds[metric] || {};
        thresholds[metric][level] = {
            min_value: row.querySelector('.input-min').value || null,
            max_value: row.querySelector('.input-max').value || null,
            severity: row.querySelector('.input-severity').value,
            enabled: row.querySelector('.input-enabled').checked ? 1 : 0,
            unit: row.dataset.unit || null
        };
    });

    fetch('/api/admin/olt_monitoring.php?action=save_thresholds', {
        method: 'POST',
        headers: buildHeaders(),
        body: JSON.stringify({ thresholds })
    })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal menyimpan threshold');
            showAlert('Threshold berhasil diperbarui', 'success');
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function resetThresholdDefaults() {
    if (!confirm('Yakin ingin mengembalikan threshold ke nilai default?')) return;
    fetch('/api/admin/olt_monitoring.php?action=thresholds', { headers: buildHeaders() })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal memuat threshold');
            renderThresholds(response.data?.thresholds || {});
            showAlert('Threshold dikembalikan ke nilai awal', 'info');
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function generateSampleData(deviceId = null) {
    const payload = {};
    if (deviceId) payload.device_id = deviceId;

    fetch('/api/admin/olt_monitoring.php?action=refresh_sample', {
        method: 'POST',
        headers: buildHeaders(),
        body: JSON.stringify(payload)
    })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal memperbarui data');
            showAlert('Data sample berhasil diperbarui', 'success');
            loadSummary();
            loadOnts();
            loadEventsTable();
            loadDevices();
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function renderDevices(devices) {
    const tbody = document.getElementById('devices-table-body');
    if (!devices.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Belum ada perangkat terdaftar</td></tr>';
        return;
    }

    tbody.innerHTML = devices.map(device => {
        const statusBadge = device.status === 'online'
            ? '<span class="badge bg-success">Online</span>'
            : '<span class="badge bg-secondary">Offline</span>';
        const updatedAt = device.updated_at ? new Date(device.updated_at).toLocaleString('id-ID') : '-';
        const ontInfo = `${device.online_onts ?? 0}/${device.total_onts ?? 0}`;
        return `
            <tr>
                <td>
                    <strong>${escapeHtml(device.name)}</strong><br>
                    <small class="text-muted">${escapeHtml(device.location ?? '-')}</small>
                </td>
                <td>${escapeHtml(device.ip_address)}<br><small class="text-muted">Port ${device.port}</small></td>
                <td>${escapeHtml(device.device_type ?? '-')}</td>
                <td>${statusBadge}</td>
                <td>${ontInfo}</td>
                <td>${updatedAt}</td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-primary" onclick="openDeviceModal(${device.id})">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-outline-danger" onclick="deleteDevice(${device.id})">
                            <i class="fas fa-trash"></i>
                        </button>
                        <button class="btn btn-outline-warning" onclick="generateSampleData(${device.id})">
                            <i class="fas fa-magic"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    }).join('');
}

function renderOnts(onts) {
    const tbody = document.getElementById('onts-table-body');
    if (!onts.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Belum ada data ONT untuk filter yang dipilih</td></tr>';
        return;
    }

    tbody.innerHTML = onts.map(ont => {
        const statusClass = `ont-status-${ont.status ?? 'offline'}`;
        const statusLabel = ont.status ? ont.status.toUpperCase() : 'UNKNOWN';
        const rxPower = ont.rx_power !== null ? `${ont.rx_power.toFixed(2)} dBm` : '-';
        const txPower = ont.tx_power !== null ? `${ont.tx_power.toFixed(2)} dBm` : '-';
        const distance = ont.distance !== null ? `${ont.distance.toFixed(2)} km` : '-';
        const lastSeen = ont.last_seen ? new Date(ont.last_seen).toLocaleString('id-ID') : '-';
        return `
            <tr>
                <td>
                    <strong>${escapeHtml(ont.customer_name ?? 'ONT')}</strong><br>
                    <small class="text-muted">${escapeHtml(ont.serial_number ?? '-')}</small>
                </td>
                <td>${escapeHtml(ont.olt_name ?? '-')}<br><small class="text-muted">${escapeHtml(ont.olt_ip ?? '')}</small></td>
                <td>${escapeHtml(ont.pon_port ?? '-')} / ${escapeHtml(ont.ont_number ?? '-')}</td>
                <td><span class="${statusClass}">${statusLabel}</span></td>
                <td>${rxPower}</td>
                <td>${txPower}</td>
                <td>${distance}</td>
                <td>${lastSeen}</td>
            </tr>
        `;
    }).join('');
}

function renderEventsTable(events) {
    const tbody = document.getElementById('events-table-body');
    if (!events.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">Belum ada event untuk filter ini</td></tr>';
        return;
    }

    tbody.innerHTML = events.map(event => {
        const timestamp = event.created_at ? new Date(event.created_at).toLocaleString('id-ID') : '-';
        const severityBadge = {
            info: 'bg-info',
            warning: 'bg-warning text-dark',
            critical: 'bg-danger'
        }[event.severity ?? 'info'] || 'bg-secondary';

        const ontLabel = event.pon_port ? `${event.pon_port}/${event.ont_number ?? '-'}` : '-';
        return `
            <tr>
                <td>${timestamp}</td>
                <td>${escapeHtml(event.olt_name ?? '-')}</td>
                <td>${escapeHtml(ontLabel)}</td>
                <td><span class="badge ${severityBadge}">${event.severity?.toUpperCase() ?? 'INFO'}</span></td>
                <td>${escapeHtml(event.title ?? '-')}</td>
                <td>${escapeHtml(event.description ?? '-')}</td>
            </tr>
        `;
    }).join('');
}

function renderRecentEvents(events) {
    const container = document.getElementById('recent-events-list');
    const placeholder = document.getElementById('events-placeholder');
    if (placeholder) placeholder.remove();

    if (!events.length) {
        container.innerHTML = '<div class="text-muted text-center py-4">Belum ada event tercatat</div>';
        return;
    }

    container.innerHTML = events.map(event => {
        const time = event.created_at ? new Date(event.created_at).toLocaleString('id-ID') : '-';
        const severityBadge = {
            info: 'bg-info',
            warning: 'bg-warning text-dark',
            critical: 'bg-danger'
        }[event.severity ?? 'info'] || 'bg-secondary';
        return `
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <strong>${escapeHtml(event.title ?? '-')}</strong>
                    <span class="badge ${severityBadge}">${event.severity?.toUpperCase() ?? 'INFO'}</span>
                </div>
                <div class="small text-muted mb-2">
                    ${escapeHtml(event.olt_name ?? '-')} • ${escapeHtml(event.pon_port ? event.pon_port + '/' + (event.ont_number ?? '-') : 'ONT -')}
                </div>
                <div>${escapeHtml(event.description ?? '-')}</div>
                <div class="text-muted small mt-1">${time}</div>
            </div>
        `;
    }).join('');
}

function renderThresholds(thresholds) {
    const tbody = document.getElementById('thresholds-table-body');
    const rows = [];
    Object.entries(thresholds).forEach(([metric, levels]) => {
        Object.entries(levels).forEach(([level, config]) => {
            const enabled = Number(config.enabled ?? 1) === 1;
            rows.push(`
                <tr data-metric="${metric}" data-level="${level}" data-unit="${config.unit ?? ''}">
                    <td><strong>${metric.toUpperCase()}</strong></td>
                    <td>${level.toUpperCase()}</td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm input-min" value="${config.min_value ?? ''}"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm input-max" value="${config.max_value ?? ''}"></td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <select class="form-select form-select-sm input-severity" style="width: 120px;">
                                <option value="info" ${config.severity === 'info' ? 'selected' : ''}>Info</option>
                                <option value="warning" ${config.severity === 'warning' ? 'selected' : ''}>Warning</option>
                                <option value="critical" ${config.severity === 'critical' ? 'selected' : ''}>Critical</option>
                            </select>
                            <div class="form-check form-switch">
                                <input class="form-check-input input-enabled" type="checkbox" ${enabled ? 'checked' : ''}>
                            </div>
                        </div>
                    </td>
                </tr>
            `);
        });
    });
    tbody.innerHTML = rows.join('');
}

function applySettingsForm(settings) {
    const getValue = key => settings[key]?.setting_value ?? '';
    document.getElementById('setting-system-name').value = getValue('system_name');
    document.getElementById('setting-polling-interval').value = getValue('polling_interval') || 300;
    document.getElementById('setting-polling-enabled').value = getValue('polling_enabled') || '1';
    document.getElementById('setting-notif-enabled').value = getValue('notifications_enabled') || '0';
    document.getElementById('setting-telegram-token').value = getValue('telegram_bot_token');
    document.getElementById('setting-telegram-chat').value = getValue('telegram_chat_id');
}

function openDeviceModal(id = null) {
    const form = document.getElementById('device-form');
    form.reset();
    document.getElementById('device-id').value = '';
    document.getElementById('deviceModalLabel').textContent = id ? 'Edit Perangkat OLT' : 'Tambah Perangkat OLT';
    toggleSnmpFields();

    if (id) {
        fetch('/api/admin/olt_monitoring.php?action=device&id=' + id, { headers: buildHeaders() })
            .then(handleJsonResponse)
            .then(response => {
                if (!response.success) throw new Error(response.message || 'Gagal memuat perangkat');
                const device = response.data?.device;
                if (!device) return;
                document.getElementById('device-id').value = device.id;
                document.getElementById('device-name').value = device.name ?? '';
                document.getElementById('device-location').value = device.location ?? '';
                document.getElementById('device-ip').value = device.ip_address ?? '';
                document.getElementById('device-port').value = device.port ?? 22;
                document.getElementById('device-total-ports').value = device.total_ports ?? 4;
                document.getElementById('device-username').value = device.username ?? '';
                document.getElementById('device-password').value = device.password ?? '';
                document.getElementById('device-polling-method').value = device.polling_method ?? 'ssh';
                document.getElementById('device-type').value = device.device_type ?? 'epon';
                document.getElementById('device-snmp-community').value = device.snmp_community ?? 'public';
                document.getElementById('device-snmp-version').value = device.snmp_version ?? 'v2c';
                toggleSnmpFields();
            })
            .catch(error => showAlert(error.message, 'danger'));
    }

    deviceModal.show();
}

function deleteDevice(id) {
    if (!confirm('Hapus perangkat ini? Data ONT terkait juga akan dihapus.')) return;
    fetch('/api/admin/olt_monitoring.php?action=delete_device', {
        method: 'POST',
        headers: buildHeaders(),
        body: JSON.stringify({ id })
    })
        .then(handleJsonResponse)
        .then(response => {
            if (!response.success) throw new Error(response.message || 'Gagal menghapus perangkat');
            showAlert('Perangkat berhasil dihapus', 'success');
            loadDevices();
            loadOnts();
        })
        .catch(error => showAlert(error.message, 'danger'));
}

function toggleSnmpFields() {
    const method = document.getElementById('device-polling-method').value;
    document.querySelectorAll('.snmp-group').forEach(el => {
        el.classList.toggle('d-none', method !== 'snmp');
    });
}

function populateOltFilters(devices) {
    const selectOlt = document.getElementById('filter-olt');
    const selectEventOlt = document.getElementById('filter-event-olt');
    const options = ['<option value="">Semua perangkat</option>'];
    const eventOptions = ['<option value="">Semua OLT</option>'];
    devices.forEach(device => {
        options.push(`<option value="${device.id}">${escapeHtml(device.name)}</option>`);
        eventOptions.push(`<option value="${device.id}">${escapeHtml(device.name)}</option>`);
    });
    selectOlt.innerHTML = options.join('');
    selectEventOlt.innerHTML = eventOptions.join('');
}

function showAlert(message, type = 'info') {
    const container = document.getElementById('alert-container');
    const wrapper = document.createElement('div');
    wrapper.className = `alert alert-${type} alert-dismissible fade show`;
    wrapper.innerHTML = `
        ${escapeHtml(message)}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    `;
    container.appendChild(wrapper);
    setTimeout(() => {
        const alert = bootstrap.Alert.getOrCreateInstance(wrapper);
        alert.close();
    }, 6000);
}

function buildHeaders() {
    return {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken,
    };
}

function handleJsonResponse(response) {
    if (!response.ok) {
        return response.json().catch(() => {
            throw new Error('Permintaan gagal dengan status ' + response.status);
        }).then(err => {
            throw new Error(err.message || 'Terjadi kesalahan');
        });
    }
    return response.json();
}

function debounce(fn, delay) {
    let timer = null;
    return (...args) => {
        clearTimeout(timer);
        timer = setTimeout(() => fn.apply(this, args), delay);
    };
}

function escapeHtml(value) {
    if (value === null || value === undefined) return '';
    return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}
</script>
</body>
</html>
