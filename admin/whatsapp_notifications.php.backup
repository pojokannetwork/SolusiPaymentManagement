<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
const csrfToken = '<?= getCsrfToken(); ?>';
$.ajaxSetup({ headers: { 'X-CSRF-Token': csrfToken } });

let templates = {};
let customers = [];
let invoices = [];
let queueSummaryTimer = null;

$(document).ready(function(){
    loadTemplates();
    loadCustomers();
    loadInvoices();
    loadQueueSummary();
    bindEvents();
    queueSummaryTimer = setInterval(loadQueueSummary, 30000);
});

function bindEvents() {
    $('#btn-refresh').on('click', function(){
        loadTemplates();
        loadCustomers();
        loadInvoices();
        loadQueueSummary();
        showAlert('Data diperbarui.', 'info');
    });

    $('#btn-save-templates').on('click', saveTemplates);

    $('[name="preview-type"]').on('change', handlePreviewTypeChange);

    $('#btn-generate').on('click', generatePreview);
    $('#btn-queue').on('click', enqueueMessage);

    $('#btn-copy-message').on('click', copyMessage);
    $('#btn-open-link').on('click', openLink);
    $('#btn-download-qr').on('click', downloadQr);
    $('#btn-refresh-queue').on('click', loadQueueSummary);

    $(window).on('unload', function(){
        if (queueSummaryTimer) {
            clearInterval(queueSummaryTimer);
        }
    });
}

function loadTemplates() {
    $.get('/api/admin/whatsapp_notifications.php', { action: 'templates' })
        .done(function(response){
            if (!response.success) throw new Error(response.message || 'Gagal memuat template');
            templates = response.data.templates || {};
            $('#template-registration').val(templates.registration || '');
            $('#template-due').val(templates.due || '');
            $('#template-general').val(templates.general || '');
            renderPlaceholders(response.data.placeholders || {});
        })
        .fail(handleAjaxError);
}

function renderPlaceholders(placeholders) {
    const container = $('#placeholders-container').empty();
    Object.keys(placeholders).forEach(group => {
        const groupTitle = $('<div class="w-100 fw-semibold mt-2"></div>').text(group.toUpperCase());
        container.append(groupTitle);
        const entries = placeholders[group];
        for (const key in entries) {
            const tag = $('<button type="button" class="placeholder-tag btn btn-sm btn-light"></button>');
            tag.attr('data-placeholder', key);
            tag.text(key + ' ');
            tag.append($('<span class="text-muted"></span>').text(entries[key]));
            tag.on('click', () => copyToClipboard(key));
            container.append(tag);
        }
    });
}

function saveTemplates() {
    const payload = {
        templates: {
            registration: $('#template-registration').val(),
            due: $('#template-due').val(),
            general: $('#template-general').val(),
        }
    };

    $.ajax({
        url: '/api/admin/whatsapp_notifications.php?action=save_templates',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload)
    })
    .done(function(response){
        if (!response.success) throw new Error(response.message || 'Gagal menyimpan template');
        showAlert('Template berhasil disimpan.', 'success');
        loadTemplates();
    })
    .fail(handleAjaxError);
}

function loadCustomers() {
    $.get('/api/admin/customers.php', { action: 'list', limit: 500 })
        .done(function(response){
            if (!response.success) return;
            customers = response.data.customers || [];
            const select = $('#select-customer').empty();
            select.append('<option value="">Pilih pelanggan...</option>');
            customers.forEach(function(customer){
                const label = customer.nama + ' • ' + (customer.kode_pelanggan || '-');
                select.append(`<option value="${customer.id}">${label}</option>`);
            });
        })
        .fail(handleAjaxError);
}

function loadInvoices() {
    $.get('/api/admin/whatsapp_notifications.php', { action: 'invoices' })
        .done(function(response){
            if (!response.success) return;
            invoices = response.data.invoices || [];
            const select = $('#select-invoice').empty();
            select.append('<option value="">Pilih invoice...</option>');
            invoices.forEach(function(invoice){
                const label = `${invoice.nomor} • ${invoice.customer_name} • ${invoice.total_formatted}`;
                select.append(`<option value="${invoice.id}">${label}</option>`);
            });
        })
        .fail(handleAjaxError);
}

function handlePreviewTypeChange() {
    const type = $('[name="preview-type"]:checked').val();
    $('#invoice-wrapper').toggle(type === 'due');
    $('#custom-message-wrapper').toggle(type === 'general');
}

function generatePreview() {
    const type = $('[name="preview-type"]:checked').val();
    const customerId = parseInt($('#select-customer').val(), 10) || 0;
    const invoiceId = parseInt($('#select-invoice').val(), 10) || 0;
    const customMessage = $('#custom-message').val();

    const payload = { type, customer_id: customerId, invoice_id: invoiceId, custom_message: customMessage };

    $.ajax({
        url: '/api/admin/whatsapp_notifications.php?action=preview',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload)
    })
    .done(function(response){
        if (!response.success) throw new Error(response.message || 'Gagal membuat preview');
        renderPreview(response.data);
    })
    .fail(handleAjaxError);
}

function renderPreview(data) {
    $('#preview-phone').text(data.phone || '-');
    $('#preview-link').val(data.link || '');
    $('#preview-message').text(data.message || '-');

    if (data.link) {
        $('#btn-open-link').prop('disabled', false);
    } else {
        $('#btn-open-link').prop('disabled', true);
    }

    if (data.qr) {
        $('#preview-qr').attr('src', data.qr).show();
        $('#qr-placeholder').hide();
        $('#btn-download-qr').prop('disabled', false).data('qr', data.qr);
    } else {
        $('#preview-qr').hide();
        $('#qr-placeholder').show();
        $('#btn-download-qr').prop('disabled', true).removeData('qr');
    }
}

function copyMessage() {
    const message = $('#preview-message').text().trim();
    if (!message) {
        showAlert('Tidak ada pesan untuk disalin.', 'warning');
        return;
    }
    copyToClipboard(message);
}

function openLink() {
    const link = $('#preview-link').val();
    if (link) {
        window.open(link, '_blank');
    }
}

function downloadQr() {
    const dataUrl = $('#btn-download-qr').data('qr');
    if (!dataUrl) return;

    const link = document.createElement('a');
    link.href = dataUrl;
    link.download = 'whatsapp-qr.png';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(function(){
        showAlert('Disalin: ' + text, 'info', 2000);
    }).catch(function(){
        showAlert('Gagal menyalin ke clipboard.', 'danger');
    });
}

function showAlert(message, type = 'info', timeout = 4000) {
    const id = 'alert-' + Date.now();
    const alert = $(`
        <div class="alert alert-${type} alert-dismissible fade show" role="alert" id="${id}">
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    `);
    $('#alert-container').append(alert);
    if (timeout > 0) {
        setTimeout(() => {
            alert.alert('close');
        }, timeout);
    }
}

function handleAjaxError(xhr) {
    const response = xhr.responseJSON || {};
    const message = response.message || 'Terjadi kesalahan pada server.';
    showAlert(message, 'danger', 6000);
}

function enqueueMessage() {
    const type = $('[name="preview-type"]:checked').val();
    const customerId = parseInt($('#select-customer').val(), 10) || 0;
    const invoiceId = parseInt($('#select-invoice').val(), 10) || 0;
    const customMessage = $('#custom-message').val().trim();
    const scheduleAt = null;

    let action = '';
    const payload = { schedule_at: scheduleAt };

    if (type === 'registration') {
        if (!customerId) {
            showAlert('Pilih pelanggan terlebih dahulu.', 'warning');
            return;
        }
        action = 'queue_registration';
        payload.customer_id = customerId;
    } else if (type === 'due') {
        if (!invoiceId) {
            showAlert('Pilih invoice terlebih dahulu.', 'warning');
            return;
        }
        action = 'queue_due';
        payload.invoice_id = invoiceId;
    } else if (type === 'general') {
        if (!customerId) {
            showAlert('Pilih pelanggan terlebih dahulu.', 'warning');
            return;
        }
        if (!customMessage) {
            showAlert('Isi pesan kustom sebelum mengirim.', 'warning');
            return;
        }
        action = 'queue_general';
        payload.customer_id = customerId;
        payload.custom_message = customMessage;
    } else {
        showAlert('Jenis pesan tidak dikenali.', 'danger');
        return;
    }

    $('#btn-queue').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Memproses...');

    $.ajax({
        url: '/api/admin/whatsapp_notifications.php?action=' + action,
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload)
    })
    .done(function(response){
        if (!response.success) throw new Error(response.message || 'Gagal menambahkan ke antrean');
        showAlert('Pesan dimasukkan ke antrean WhatsApp.', 'success');
        loadQueueSummary();
    })
    .fail(handleAjaxError)
    .always(function(){
        $('#btn-queue').prop('disabled', false).html('<i class="fas fa-paper-plane me-2"></i>Kirim via Antrean');
    });
}

function loadQueueSummary() {
    $.get('/api/admin/whatsapp_notifications.php', { action: 'queue_summary' })
        .done(function(response){
            if (!response.success) return;
            renderQueueSummary(response.data || {});
        })
        .fail(handleAjaxError);
}

function renderQueueSummary(data) {
    const summary = data.summary || {};
    $('#queue-summary-pending').text(summary.pending ?? 0);
    $('#queue-summary-processing').text(summary.processing ?? 0);
    $('#queue-summary-sent').text(summary.sent ?? 0);
    $('#queue-summary-failed').text(summary.failed ?? 0);

    renderSessions(data.sessions || []);
    renderQueueList('#pending-queue-container', data.pending || []);
    renderQueueList('#failed-queue-container', data.failed || []);
}

function renderSessions(sessions) {
    const container = $('#session-status-container').empty();
    const qrImg = $('#session-qr');
    const qrPlaceholder = $('#session-qr-placeholder');

    if (!sessions.length) {
        container.text('Belum ada sesi yang tercatat.');
        qrImg.hide();
        qrPlaceholder.show().text('QR login akan tampil di sini saat sesi membutuhkan autentikasi.');
        return;
    }

    sessions.forEach(function(session){
        const card = $('<div class="mb-2"></div>');
        const statusBadge = getStatusBadge(session.status || 'disconnected');
        const info = session.info || {};
        card.append(`<div><strong>${session.session_name}</strong> ${statusBadge}</div>`);
        if (info.pushname) {
            card.append(`<div>Nama WA: ${info.pushname}</div>`);
        }
        if (info.phone) {
            card.append(`<div>Nomor: ${info.phone}</div>`);
        }
        if (session.last_seen) {
            card.append(`<div class="text-muted">Aktif: ${session.last_seen}</div>`);
        }
        if (session.error_message) {
            card.append(`<div class="text-danger small">${session.error_message}</div>`);
        }
        container.append(card);

        if (session.status === 'qr' && session.qr_base64) {
            qrImg.attr('src', session.qr_base64).show();
            qrPlaceholder.hide();
        }
    });

    if (!sessions.some(s => s.status === 'qr' && s.qr_base64)) {
        qrImg.hide();
        qrPlaceholder.show().text('Tidak ada QR login yang aktif saat ini.');
    }
}

function renderQueueList(containerSelector, items) {
    const container = $(containerSelector).empty();
    if (!items.length) {
        container.text('Tidak ada data.');
        return;
    }

    items.forEach(function(item){
        const wrapper = $('<div class="border-bottom py-2"></div>');
        const name = item.customer_name ? `${item.customer_name}` : '(Tanpa nama)';
        wrapper.append(`<div><strong>${name}</strong> <span class="text-muted small">(${item.phone})</span></div>`);
        wrapper.append(`<div class="small text-muted">${item.message_type} • Jadwal: ${item.scheduled_at}</div>`);
        wrapper.append(`<div class="small">${item.message}</div>`);
        if (item.status === 'failed' && item.last_error) {
            wrapper.append(`<div class="small text-danger">Error: ${item.last_error}</div>`);
        }
        container.append(wrapper);
    });
}

function getStatusBadge(status) {
    const classes = {
        ready: 'bg-success',
        connecting: 'bg-warning text-dark',
        qr: 'bg-info text-dark',
        error: 'bg-danger',
        disconnected: 'bg-secondary'
    };
    const label = status.charAt(0).toUpperCase() + status.slice(1);
    const badgeClass = classes[status] || 'bg-secondary';
    return `<span class="badge ${badgeClass}">${label}</span>`;
}
</script>
</body>
</html>
