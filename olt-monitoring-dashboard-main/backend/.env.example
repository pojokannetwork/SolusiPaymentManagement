# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=olt_monitoring
DB_USER=root
DB_PASSWORD=your_password

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Telegram Bot (will be configured via Settings page)
TELEGRAM_BOT_TOKEN=

# OLT Polling Configuration
POLLING_INTERVAL=30000
SSH_TIMEOUT=10000

# Logging
LOG_LEVEL=info